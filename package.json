{
  "name": "advanced-git-hooks-workflow",
  "version": "1.0.0",
  "description": "advanced-git-hooks-workflow is a production-ready Git automation system that enforces commit standards, code quality, and repository governance using Husky, Commitlint, ESLint, Prettier, and lint-staged. It ensures clean history, automated validation, and CI/CD-friendly workflows for scalable teams and enterprise projects.",
  "main": "server.js",
  "scripts": {
    "prepare": "husky",
    "format": "prettier  --write .",
    "format:check": "prettier --check .",
    "eslint": "eslint .",
    "eslint:fix": "eslint . fix",
    "dev": "cross-env NODE_ENV=development nodemon server.js",
    "prod": "cross-env NODE_ENV=production node server.js",
    "test": "cross-env NODE_ENV=test node server.js",
    "swagger:gen": "node docs/swagger.docs.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/93sahcflas77/advanced-git-hooks-workflow.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/93sahcflas77/advanced-git-hooks-workflow/issues"
  },
  "homepage": "https://github.com/93sahcflas77/advanced-git-hooks-workflow#readme",
  "devDependencies": {
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@eslint/js": "^10.0.1",
    "conventional-changelog-atom": "^5.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.0.2",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.1"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "mongoose": "^8.23.0",
    "mongoose-to-swagger": "^1.5.1",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "yamljs": "^0.3.0"
  }
